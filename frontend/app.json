{
  "expo": {
    "name": "SS Spend Tracker",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan payment receipts to track spend",
        "NSPhotoLibraryUsageDescription": "Pick payment screenshots to log expenses"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F2F2F7"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick payment screenshots to log expenses",
          "cameraPermission": "Scan payment receipts to track spend"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
